# Create .env from this template and replace every example value.
NEXUS_DOMAIN=nexus-code.duckdns.org
NEXUS_PUBLIC_ORIGIN=https://nexus-code.duckdns.org
NEXUS_SETUP_SECRET=replace-with-a-long-random-private-value
NEXUS_CONTACT_EMAIL=

# DuckDNS account values. DUCKDNS_DOMAIN is the label only (nexus-code),
# while NEXUS_DOMAIN above is the full hostname.
DUCKDNS_DOMAIN=nexus-code
DUCKDNS_TOKEN=replace-with-your-private-duckdns-token
